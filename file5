import pandas as pd
import math
import numpy as np
from collections import defaultdict
from itertools import combinations
from pathlib import Path

#
# 1. LOAD DATASET
#

def load_dataset():
    path = Path(r"C:\Users\Sayali\Downloads\tuned_hospital_dataset.csv")
    if path.exists():
        print(f"[INFO] Loading dataset from {path}")
        return pd.read_csv(path)
    else:
        raise FileNotFoundError("Dataset not found")

df = load_dataset()

#
# 2. PREPROCESS
#

def preprocess(df):
    col = [c for c in df.columns if "symptom" in c.lower()][0]

    symptom_lists = df[col].astype(str).apply(lambda x: x.split(','))

    all_symptoms = sorted({s.strip() for row in symptom_lists for s in row})
    matrix = []

    for row in symptom_lists:
        row_set = set(s.strip() for s in row)
        matrix.append([s in row_set for s in all_symptoms])

    return pd.DataFrame(matrix, columns=all_symptoms)

symptom_df = preprocess(df)

#
# 3. APRIORI
#

def apriori(df, min_support=0.1, max_len=3):
    items = list(df.columns)
    total = len(df)
    freq = []

    for size in range(1, max_len + 1):
        for combo in combinations(items, size):
            mask = df[list(combo)].all(axis=1)
            support = mask.sum() / total

            if support >= min_support:
                freq.append({
                    "itemsets": frozenset(combo),
                    "support": support
                })

    return pd.DataFrame(freq)

freq = apriori(symptom_df)

#
# 4. ASSOCIATION RULES (ALL METRICS)
#

def generate_rules(freq_df, min_conf=0.5, min_support=0.1):
    support_map = {
        row['itemsets']: row['support']
        for _, row in freq_df.iterrows()
    }

    rules = []

    for itemset, support in support_map.items():
        if len(itemset) < 2:
            continue

        for r in range(1, len(itemset)):
            for antecedent in combinations(itemset, r):
                antecedent = frozenset(antecedent)
                consequent = itemset - antecedent

                support_A = support_map.get(antecedent, 0)
                support_B = support_map.get(consequent, 0)

                if support_A == 0 or support_B == 0:
                    continue

                confidence = support / support_A
                lift = confidence / support_B

                conviction = (1 - support_B) / (1 - confidence) if confidence != 1 else float("inf")
                cosine = support / math.sqrt(support_A * support_B)

                if confidence >= min_conf and support >= min_support:
                    rules.append({
                        "antecedents": antecedent,
                        "consequents": consequent,
                        "support": support,
                        "confidence": confidence,
                        "lift": lift,
                        "conviction": conviction,
                        "cosine": cosine
                    })

    df_rules = pd.DataFrame(rules)
    return df_rules.sort_values(by="confidence", ascending=False)

rules = generate_rules(freq)

#
# 5. RULE SUMMARY + DISPLAY


def rule_summary(rules):
    print("\n RULE QUALITY SUMMARY")
    print(f"Total Rules: {len(rules)}")

    print(f"High (>0.8): {len(rules[rules['confidence'] > 0.8])}")
    print(f"Medium (0.5–0.8): {len(rules[(rules['confidence'] > 0.5) & (rules['confidence'] <= 0.8)])}")
    print(f"Low (<0.5): {len(rules[rules['confidence'] <= 0.5])}")

def display_rules(rules, top_n=5):
    print("\n TOP ASSOCIATION RULES")

    for i, r in enumerate(rules.head(top_n).iterrows(), 1):
        r = r[1]
        strength = " STRONG" if r['confidence'] >= 0.8 else "⚡ MODERATE"

        print(f"\nRule {i} {strength}")
        print(f"  {list(r['antecedents'])} → {list(r['consequents'])}")
        print(f"  Conf: {r['confidence']:.2f}, Lift: {r['lift']:.2f}, Cosine: {r['cosine']:.2f}")

rule_summary(rules)
display_rules(rules)

#
# 6. GRAPH
#

class SymptomGraph:
    def __init__(self):
        self.graph = defaultdict(dict)

    def add_edge(self, a, b, weight):
        self.graph[a][b] = max(self.graph[a].get(b, 0), weight)
        self.graph[b][a] = max(self.graph[b].get(a, 0), weight)

    def build(self, rules):
        for _, r in rules.iterrows():
            for a in r['antecedents']:
                for b in r['consequents']:
                    self.add_edge(a, b, r['confidence'])

graph = SymptomGraph()
graph.build(rules)

#
# 7. BFS EXPANSION
#

def expand(graph, symptoms, depth=2):
    visited = set(symptoms)
    queue = [(s, 0) for s in symptoms]

    while queue:
        node, d = queue.pop(0)

        if d < depth:
            for neigh in graph.graph.get(node, {}):
                if neigh not in visited:
                    visited.add(neigh)
                    queue.append((neigh, d+1))

    return list(visited)

#
# 8. DISEASE PROFILES
#

def build_profiles(df, symptom_df):
    profiles = {}
    for d in df["Disease"].unique():
        idx = df[df["Disease"] == d].index
        profiles[d] = symptom_df.loc[idx].mean()
    return profiles

profiles = build_profiles(df, symptom_df)

#
# 9. COSINE (MANUAL)
#

def cosine_manual(a, b):
    dot = np.dot(a, b)
    norm_a = np.linalg.norm(a)
    norm_b = np.linalg.norm(b)

    if norm_a == 0 or norm_b == 0:
        return 0

    return dot / (norm_a * norm_b)

#
# 10. PREDICTION
#

def predict_disease(symptoms):
    expanded = expand(graph, symptoms)

    vec = np.array([1 if s in expanded else 0 for s in symptom_df.columns])

    scores = {}
    for d, profile in profiles.items():
        sim = cosine_manual(vec, profile.values)
        scores[d] = sim

    return sorted(scores.items(), key=lambda x: x[1], reverse=True)

#
# 11. DIAGNOSIS OUTPUT (IMPROVED)
#

def diagnose(symptoms):
    print("\n" + "="*50)
    print("\n PATIENT DIAGNOSIS REPORT")
    print("="*50)

    print("\n Input Symptoms:")
    print(symptoms)

    expanded = expand(graph, symptoms)
    print("\n Expanded Symptoms:")
    print(expanded)

    print("\n Disease Prediction:")
    preds = predict_disease(symptoms)

    for i, (d, s) in enumerate(preds[:3], 1):
        level = "HIGH" if s > 0.8 else "MEDIUM" if s > 0.5 else "LOW"
        print(f"{i}. {d} → {s:.2f} ({level})")

    print("\n Explanation:")
    print("- Based on symptom similarity")
    print("- Graph-based inference")
    print("- Association rules")

    print("="*50 + "\n")

