# ============================================================
# 7. GRAPH
# ============================================================

class SymptomGraph:
    def __init__(self):
        self.graph = defaultdict(dict)

    def add_edge(self, a, b, weight):
        self.graph[a][b] = max(self.graph[a].get(b, 0), weight)
        self.graph[b][a] = max(self.graph[b].get(a, 0), weight)

    def build(self, rules):
        for _, r in rules.iterrows():
            for a in r['antecedents']:
                for b in r['consequents']:
                    self.add_edge(a, b, r['confidence'])

graph = SymptomGraph()
graph.build(rules)


# ============================================================
# 8. BFS EXPANSION
# ============================================================

def expand(graph, symptoms, depth=2):
    visited = set(symptoms)
    queue = [(s, 0) for s in symptoms]

    while queue:
        node, d = queue.pop(0)

        if d < depth:
            for neigh in graph.graph.get(node, {}):
                if neigh not in visited:
                    visited.add(neigh)
                    queue.append((neigh, d+1))

    return list(visited)


# ============================================================
# 9. DISEASE PROFILES
# ============================================================

def build_profiles(df, symptom_df):
    profiles = {}

    for d in df["Disease"].unique():
        idx = df[df["Disease"] == d].index
        profiles[d] = symptom_df.loc[idx].mean()

    return profiles

profiles = build_profiles(df, symptom_df)


# ============================================================
# 10. HYBRID PREDICTION
# ============================================================

def predict_disease(symptoms):
    expanded = expand(graph, symptoms)

    vec = np.array([1 if s in expanded else 0 for s in symptom_df.columns]).reshape(1, -1)

    scores = {}

    for d, profile in profiles.items():
        sim = cosine_similarity(vec, profile.values.reshape(1, -1))[0][0]
        scores[d] = sim

    return sorted(scores.items(), key=lambda x: x[1], reverse=True)


# ============================================================
# 11. PIPELINE
# ============================================================

def diagnose(symptoms):
    print("\n==============================")
    print("[INPUT]", symptoms)

    expanded = expand(graph, symptoms)
    print("[EXPANDED]", expanded)

    preds = predict_disease(symptoms)

    print("\n[DISEASE PREDICTION]")
    for d, s in preds[:3]:
        print(f"{d}: {s:.2f}")

    print("==============================\n")


