import pandas as pd
from mlxtend.frequent_patterns import apriori, association_rules

# Example dataset (1 = symptom present)
data = [
    {"yellow_skin":1, "dark_urine":1, "fatigue":1, "fever":0, "nausea":0},
    {"yellow_skin":1, "dark_urine":1, "fatigue":0, "fever":1, "nausea":1},
    {"yellow_skin":0, "dark_urine":0, "fatigue":1, "fever":1, "nausea":1},
    {"yellow_skin":1, "dark_urine":1, "fatigue":1, "fever":1, "nausea":1},
]

df = pd.DataFrame(data)

# Step 1: Frequent itemsets
frequent = apriori(df, min_support=0.5, use_colnames=True)

# Step 2: Association rules
rules = association_rules(frequent, metric="confidence", min_threshold=0.7)

print("\n[Association Rules]")
print(rules[['antecedents', 'consequents', 'support', 'confidence']])

