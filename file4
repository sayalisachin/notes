df = load_dataset()


# ============================================================
# 2. PREPROCESS
# ============================================================

def preprocess(df):
    col = [c for c in df.columns if "symptom" in c.lower()][0]

    symptom_lists = df[col].astype(str).apply(lambda x: x.split(','))

    all_symptoms = sorted({s.strip() for row in symptom_lists for s in row})
    matrix = []

    for row in symptom_lists:
        row_set = set(s.strip() for s in row)
        matrix.append([s in row_set for s in all_symptoms])

    return pd.DataFrame(matrix, columns=all_symptoms)

symptom_df = preprocess(df)


# ============================================================
# 3. APRIORI
# ============================================================

def apriori(df, min_support=0.1, max_len=3):
    items = list(df.columns)
    total = len(df)
    freq = []

    for size in range(1, max_len + 1):
        for combo in combinations(items, size):
            mask = df[list(combo)].all(axis=1)
            support = mask.sum() / total

            if support >= min_support:
                freq.append({
                    "itemsets": frozenset(combo),
                    "support": support
                })

    return pd.DataFrame(freq)

freq = apriori(symptom_df)


# ============================================================
# 4. ASSOCIATION RULES (ALL METRICS + FIXES)
# ============================================================

def generate_rules(freq_df, min_conf=0.5, min_support=0.1):
    support_map = {
        row['itemsets']: row['support']
        for _, row in freq_df.iterrows()
    }

    rules = []

    for itemset, support in support_map.items():
        if len(itemset) < 2:
            continue

        for r in range(1, len(itemset)):
            for antecedent in combinations(itemset, r):
                antecedent = frozenset(antecedent)
                consequent = itemset - antecedent

                support_A = support_map.get(antecedent, 0)
                support_B = support_map.get(consequent, 0)

                if support_A == 0 or support_B == 0:
                    continue

                confidence = support / support_A
                lift = confidence / support_B

                # Conviction
                conviction = (1 - support_B) / (1 - confidence) if confidence != 1 else float("inf")

                # Cosine
                cosine = support / math.sqrt(support_A * support_B)

                # ✅ FIX: Apply BOTH support + confidence thresholds
                if confidence >= min_conf and support >= min_support:
                    rules.append({
                        "antecedents": antecedent,
                        "consequents": consequent,
                        "support": support,
                        "confidence": confidence,
                        "lift": lift,
                        "conviction": conviction,
                        "cosine": cosine
                    })

    df_rules = pd.DataFrame(rules)
    return df_rules.sort_values(by="confidence", ascending=False)

rules = generate_rules(freq)


