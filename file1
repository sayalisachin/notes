# LLM (Large Language Model)
#  Interprets expanded symptom set
#  Handles uncertainty and partial inputs
#  Provides diagnosis with explanation
#  "Thinks like a doctor"



from collections import defaultdict

class SymptomGraph:
    def __init__(self):
        self.graph = defaultdict(list)

    def add_edge(self, symptom1, symptom2):
        self.graph[symptom1].append(symptom2)
        self.graph[symptom2].append(symptom1)

    def build_from_rules(self, rules):
        for _, row in rules.iterrows():
            for a in row['antecedents']:
                for b in row['consequents']:
                    self.add_edge(a, b)

    def display(self):
        print("\n[Adjacency List]")
        for k, v in self.graph.items():
            print(k, "->", v)
    def diagnose_with_graph(graph, patient_symptoms):
        related = set()

        for symptom in patient_symptoms:
            related.update(graph.graph.get(symptom, []))

    return related
