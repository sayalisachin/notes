#BUILD DISEASE PROFILES
def build_disease_profiles(df, symptom_df):
    """
    Create average symptom vector for each disease
    """
    if "Disease" not in df.columns:
        raise ValueError("Dataset must have 'Disease' column")

    disease_profiles = {}

    for disease in df["Disease"].unique():
        indices = df[df["Disease"] == disease].index
        disease_profiles[disease] = symptom_df.loc[indices].mean()

    return disease_profiles


