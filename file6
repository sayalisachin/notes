# SIMILARITY FUNCTION
from ast import For

from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

def predict_disease(expanded_symptoms, all_symptoms, disease_profiles):
    """
    Compare patient vector with disease profiles
    """

    # Convert patient symptoms → vector
    patient_vec = np.array([
        1 if s in expanded_symptoms else 0
        for s in all_symptoms
    ]).reshape(1, -1)

    scores = {}

    for disease, profile in disease_profiles.items():
        profile_vec = profile.values.reshape(1, -1)
        score = cosine_similarity(patient_vec, profile_vec)[0][0]
        scores[disease] = score

    # Sort
    sorted_scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)

    return sorted_scores

